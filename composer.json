{
    "name": "schmidtwebmedia/sepa-donate",
    "description": "TYPO3 extension for SEPA donations with EPC GiroCode QR generation",
    "type": "typo3-cms-extension",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Marco Schmidt - Webmedia",
            "role": "Developer"
        }
    ],
    "require": {
        "typo3/cms-core": "^13.0 || ^14.0",
        "typo3/cms-extbase": "^13.0 || ^14.0",
        "typo3/cms-fluid": "^13.0 || ^14.0",
        "bacon/bacon-qr-code": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Schmidtwebmedia\\SepaDonate\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "sepa_donate"
        }
    },
    "config": {
        "allow-plugins": {
            "typo3/cms-composer-installers": true,
            "typo3/class-alias-loader": true
        }
    }
}
